DATABASE_URL="postgresql://erp:erp@localhost:5432/erp_dev"
REDIS_URL="redis://localhost:6379"
JWT_SECRET="change-me-in-production-min-32-chars"
JWT_REFRESH_SECRET="change-me-refresh-in-production-min-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="30d"
PRINTNODE_API_KEY="your-printnode-dev-key"
RESEND_API_KEY="your-resend-key"
RESEND_FROM="noreply@yourdomain.com"
NODE_ENV="development"
PORT=3001
FRONTEND_URL="http://localhost:3000"
# Chiffrement des clés des prestataires de paiement (32 octets en hexadécimal)
# Générer : openssl rand -hex 32
SECRETS_KEY=""

# Abonnement (Stripe Billing). Sans ces clés, l'essai continue et rien n'est facturé.
# Prix récurrents mensuels créés dans Stripe, quantité = nombre de boutiques.
STRIPE_BILLING_SECRET_KEY=
STRIPE_PRICE_STARTER=
STRIPE_PRICE_PRO=
# Webhook Stripe vers https://<api>/api/billing/webhook : checkout.session.completed, customer.subscription.*
STRIPE_BILLING_WEBHOOK_SECRET=

# Code vendeur : clé HMAC des codes à 4 chiffres (à défaut, JWT_SECRET)
PIN_SECRET=
# Derrière un répartiteur de charge : nombre de relais (IP réelle des clients)
TRUST_PROXY=

# Conformité fiscale (art. 286 I 3° bis CGI)
# Identité de l'éditeur portée sur l'attestation individuelle (BOI-LETTRE-000242).
# Sans ces cinq valeurs, aucune attestation n'est délivrée.
EDITOR_COMPANY=
# Forme : SAS, SARL... ou « entrepreneur individuel » (adapte le volet 1)
EDITOR_STATUS=
EDITOR_SIREN=
EDITOR_ADDRESS=
EDITOR_REPRESENTATIVE=
EDITOR_CITY=
# Clé de signature de l'éditeur (ECDSA P-256, PEM PKCS8, \n échappés) : scelle
# archives et attestations. À défaut, générée une fois et gardée chiffrée en base.
FISCAL_SIGNING_KEY=
# Clôtures automatiques des jours d'activité terminés (on par défaut)
FISCAL_AUTO_CLOSE=on
# Alerte « caisse non clôturée » au gérant (toutes les 5 minutes) ; off pour couper
ROUTINE_ALERTS=on

# Aide et support dans l'application. Le délai annoncé aux commerçants est
# une promesse commerciale : à fixer par la direction, jamais dans le code.
# Délai de première réponse, en minutes ouvrées (défaut 120)
SUPPORT_SLA_MINUTES=120
# Délai quand la caisse ne peut plus encaisser (défaut 30)
SUPPORT_URGENT_SLA_MINUTES=30
# Heures d'ouverture, heure de Paris. Jours lun mar mer jeu ven sam dim, en
# intervalle ou en liste ; plusieurs plages séparées par « ; », par exemple
# « lun-ven 08:00-20:00; sam 09:00-13:00 ». Vide : le délai court en continu.
# Valeur illisible : aucun délai n'est annoncé (erreur dans les journaux).
SUPPORT_HOURS="lun-sam 08:00-20:00"
# Heures propres aux urgences (facultatif, sinon SUPPORT_HOURS)
SUPPORT_URGENT_HOURS=
# Adresses prévenues à chaque nouvelle demande ou nouveau message (virgules)
SUPPORT_TEAM_EMAILS=
# Comptes FLŌW autorisés à répondre depuis /support-team (e-mails de connexion, virgules).
# Créer ces comptes AVANT de les lister : une adresse listée mais libre pourrait
# être prise à l’inscription par quelqu’un d’autre et voir toutes les demandes.
SUPPORT_AGENT_EMAILS=
# Contact nommé affiché pendant l'essai (facultatif ; vide : rien n'est affiché)
SUPPORT_TRIAL_CONTACT_NAME=
SUPPORT_TRIAL_CONTACT_PHONE=
