// Sprint 1 + Sprint 2 — schema complet
// Règle : migrations additives uniquement, jamais de reset en prod

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// SPRINT 1 — Organisation & Multi-tenant
// ============================================================

model Organization {
  customers            Customer[]
  id                   String                @id @default(cuid())
  name                 String
  slug                 String                @unique
  plan                 Plan                  @default(STARTER)
  // Abonnement : essai sans carte, puis Stripe Billing si configuré
  subscriptionStatus   SubscriptionStatus    @default(TRIALING)
  trialEndsAt          DateTime?
  stripeCustomerId     String?               @unique
  stripeSubscriptionId String?               @unique
  currentPeriodEnd     DateTime?
  // Plateforme multi-secteurs : le secteur pré-remplit les packs, la TVA et les
  // moyens de paiement ; les packs activent les fonctions métier
  sector               Sector                @default(GENERAL)
  packs                Pack[]                @default([])
  // Commerce de détail : prix saisis TTC. B2B pur : prix HT.
  priceIncludesTax     Boolean               @default(true)
  currency             String                @default("EUR")
  // Étiquettes de balance (EAN-13 à prix ou poids intégré) : règles par
  // préfixe ; vide = réglage par défaut
  scaleBarcodes        Json?
  taxRates             TaxRate[]
  paymentMethods       PaymentMethod[]
  attributeDefinitions AttributeDefinition[]
  storeCredits         StoreCredit[]
  paymentAccounts      PaymentAccount[]
  sites                Site[]
  users                User[]
  settings             OrganizationSettings?
  invoiceSequences     InvoiceSequence[]
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
}

// ============================================================
// SPRINT 8 — Paramètres légaux + E-invoicing + Séquence factures
// ============================================================

// Informations légales de l'organisation (SIRET, TVA, PDP...)
model OrganizationSettings {
  id                   String       @id @default(cuid())
  organizationId       String       @unique
  organization         Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Identité légale
  siret                String? // 14 chiffres
  vatNumber            String? // FR + 11 chiffres
  legalForm            String? // SAS, SARL, SA...
  capital              Decimal?     @db.Decimal(15, 2)
  rcs                  String? // Tribunal de commerce
  legalAddress         String?
  legalCity            String?
  legalZipCode         String?
  // E-invoicing Plateforme Agréée (sept. 2026)
  pdpName              String? // ex. "Chorus Pro", "Yooz", "Pennylane"
  pdpEndpoint          String? // URL endpoint PDP
  pdpApiKey            String? // Clé API chiffrée (at-rest)
  pdpEnabled           Boolean      @default(false)
  // Ticket : sur demande du client (AGEC), toujours, ou jamais ; note de
  // service imprimée en double à partir de 25 € TTC (restauration, services)
  receiptPolicy        String       @default("ASK")
  serviceNote          Boolean      @default(false)
  receiptFooter        String?
  // Fidélité, incluse dans tous les forfaits : désactivée tant que le
  // commerçant ne l'a pas réglée (c'est lui qui fixe ce qu'il offre)
  loyaltyEnabled       Boolean      @default(false)
  // Points gagnés par euro payé, seuil et valeur de la récompense (remise)
  loyaltyPointsPerEuro Decimal      @default(1) @db.Decimal(6, 2)
  loyaltyThreshold     Int          @default(100)
  loyaltyReward        Decimal      @default(5) @db.Decimal(10, 2)
  // Validité des cartes cadeaux vendues, en mois (null : sans limite)
  giftCardMonths       Int?         @default(12)
  updatedAt            DateTime     @updatedAt
}

// Séquence de numérotation factures — JAMAIS de gap (obligation légale FR)
model InvoiceSequence {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  year           Int
  lastNumber     Int          @default(0)
  prefix         String       @default("FA") // ex. "FA" → FA-2026-0001

  @@unique([organizationId, year])
}

model Site {
  id              String            @id @default(cuid())
  organizationId  String
  organization    Organization      @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name            String
  address         String?
  timezone        String            @default("Europe/Paris")
  // Approvisionnement interne : un labo, une cuisine centrale ou un dépôt
  // fournit les autres sites de l'organisation
  isSupplier      Boolean           @default(false)
  // Heure limite (heure locale « HH:MM ») pour une livraison dans leadDays jours
  orderCutoff     String            @default("18:00")
  leadDays        Int               @default(1)
  // Caisse : fond laissé dans le tiroir et écart toléré sans justification
  cashFloat       Decimal           @default(150) @db.Decimal(10, 2)
  cashTolerance   Decimal           @default(2) @db.Decimal(10, 2)
  // Réglage automatique (par défaut) : fond et tolérance calculés sur les
  // ventes en espèces ; cashFloat et cashTolerance servent si on le coupe
  cashAuto        Boolean           @default(true)
  routine         SiteRoutine?
  supplyOrdersOut SupplyOrder[]     @relation("SupplyFrom")
  supplyOrdersIn  SupplyOrder[]     @relation("SupplyTo")
  users           UserSite[]
  receiptChains   ReceiptChain[]
  terminals       Terminal[]
  paymentDevices  PaymentDevice[]
  categories      Category[]
  products        Product[]
  modifierGroups  ModifierGroup[]
  displays        CustomerDisplay[]
  orders          Order[]
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  cashSessions    CashSession[]
  fiscalClosures  FiscalClosure[]

  @@index([organizationId])
}

model User {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String       @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           Role         @default(SELLER)
  // Code vendeur à 4 chiffres : empreinte HMAC (clé serveur), unique dans
  // l'organisation pour identifier la personne sans e-mail
  // Incrémenté pour révoquer toutes les sessions (rôle changé, mot de passe changé, déconnexion partout)
  tokenVersion   Int          @default(0)
  pinLookup      String?
  pinSetAt       DateTime?
  // Badge : carte à QR code ou badge NFC, même principe (empreinte seulement)
  badgeLookup    String?
  badgeKind      String? // QR | NFC
  badgeSetAt     DateTime?
  sites          UserSite[]
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, pinLookup])
  @@unique([organizationId, badgeLookup])
  @@index([organizationId])
}

model UserSite {
  userId String
  siteId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  site   Site   @relation(fields: [siteId], references: [id], onDelete: Cascade)

  @@id([userId, siteId])
}

// ============================================================
// SPRINT 1 — NF525 : chaîne de hachage des tickets
// ⚠️ signReceipt() obligatoire avant toute création de Order
// ⚠️ counter immuable par site, jamais de gap, jamais de reset
// ============================================================

model ReceiptChain {
  id                   String     @id @default(cuid())
  siteId               String
  site                 Site       @relation(fields: [siteId], references: [id])
  counter              Int
  hash                 String // SHA-256(previousHash|total|signedAt|counter)
  previousHash         String // "0"×64 pour le premier ticket
  total                Decimal    @db.Decimal(10, 2) // calculé serveur uniquement
  signedAt             DateTime   @default(now())
  // Lien vers la commande (FK sur Order — pas sur ReceiptChain)
  order                Order?
  // Ticket signé par la caisse au moment de la vente (en ligne ou non).
  // La chaîne du site est prolongée à la synchronisation ; la chaîne de la
  // caisse est vérifiée puis conservée telle quelle.
  terminalId           String?
  terminal             Terminal?  @relation(fields: [terminalId], references: [id], onDelete: Restrict)
  terminalCounter      Int?
  terminalHash         String?
  terminalPreviousHash String?
  terminalSignature    String? // ECDSA P-256 (r||s) en base64
  terminalSignedAt     DateTime?
  // Grand livre v2 : l'empreinte couvre aussi le site, la caisse, le sens de
  // l'opération, le contenu et les totaux perpétuels (v1 : maillons anciens)
  version              Int        @default(1)
  kind                 OrderKind?
  contentDigest        String?
  // Total perpétuel (somme algébrique depuis le premier ticket du site) et
  // cumul en valeur absolue : jamais remis à zéro, même à une mise à jour
  perpetualTotal       Decimal?   @db.Decimal(14, 2)
  perpetualAbsTotal    Decimal?   @db.Decimal(14, 2)

  @@unique([siteId, counter])
  @@unique([terminalId, terminalCounter])
  @@index([siteId])
}

// ============================================================
// SPRINT 2 — Catalogue produits
// ============================================================

model Category {
  id       String    @id @default(cuid())
  siteId   String
  site     Site      @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name     String
  color    String? // hex — pour l'indicateur couleur dans la grille POS
  position Int       @default(0)
  products Product[]

  @@index([siteId])
}

model Product {
  id                  String                 @id @default(cuid())
  siteId              String
  site                Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name                String
  subtitle            String? // ex. "Origine Ghana 72%"
  description         String?
  sku                 String?
  barcode             String?
  price               Decimal                @db.Decimal(10, 2)
  taxRate             Decimal                @default(5.5) @db.Decimal(5, 2)
  categoryId          String?
  category            Category?              @relation(fields: [categoryId], references: [id])
  variants            Variant[]
  orderItems          OrderItem[]
  // Back-relations Sprint 4 — ajoutées via migration additive
  stockItem           StockItem?
  allergens           ProductAllergen[]
  // Cœur multi-secteurs
  options             ProductOption[]
  attributes          Json                   @default("{}") // valeurs des AttributeDefinition, par clé
  tracking            TrackingMode           @default(NONE)
  // Produit technique « Article libre » du site : nom et prix saisis en caisse
  // Article du catalogue d'exemple chargé à l'inscription (retirable d'un geste)
  isSample            Boolean                @default(false)
  // Produit technique « Carte cadeau » : montant saisi en caisse, code imprimé
  isGiftCard          Boolean                @default(false)
  isCustom            Boolean                @default(false)
  // Produit d'un labo ou d'un dépôt proposé aux boutiques, à son prix de cession
  orderable           Boolean                @default(false)
  supplyPrice         Decimal?               @db.Decimal(10, 2)
  supplyUnit          String? // « pièce », « kg », « bac de 12 »
  // Payable en titre-restaurant (aliments et boissons non alcoolisées)
  mealVoucherEligible Boolean                @default(false)
  lots                StockLot[]
  // Options et suppléments proposés à la vente (cuisson, sauce, extra...)
  modifierGroups      ProductModifierGroup[]
  // Formule : prix unique, composants choisis étape par étape
  isMenu              Boolean                @default(false)
  menuSteps           MenuStep[]
  menuChoices         MenuChoice[]
  // Vente au poids : price est le prix au kilo
  soldByWeight        Boolean                @default(false)
  // Code article de la balance étiqueteuse (PLU), lu dans l'EAN-13
  scaleCode           String?
  isActive            Boolean                @default(true)
  imageUrl            String?
  createdAt           DateTime               @default(now())
  updatedAt           DateTime               @updatedAt

  @@index([siteId])
  @@index([siteId, isActive])
  @@index([barcode])
  @@index([siteId, scaleCode])
}

// Groupe d'options d'un site (« Cuisson », « Suppléments »), partagé entre produits
model ModifierGroup {
  id        String                 @id @default(cuid())
  siteId    String
  site      Site                   @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name      String
  // Choix minimum (1 = obligatoire) et maximum (null = sans limite)
  minSelect Int                    @default(0)
  maxSelect Int?
  position  Int                    @default(0)
  isActive  Boolean                @default(true)
  modifiers Modifier[]
  products  ProductModifierGroup[]

  @@index([siteId])
}

model Modifier {
  id       String        @id @default(cuid())
  groupId  String
  group    ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  name     String
  // Supplément ajouté au prix de l'article, au taux de TVA de l'article
  price    Decimal       @default(0) @db.Decimal(10, 2)
  position Int           @default(0)
  isActive Boolean       @default(true)

  @@index([groupId])
}

model ProductModifierGroup {
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  groupId   String
  group     ModifierGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  position  Int           @default(0)

  @@id([productId, groupId])
  @@index([groupId])
}

// Étape d'une formule (« Plat », « Boisson », « Dessert »)
model MenuStep {
  id        String       @id @default(cuid())
  menuId    String
  menu      Product      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  name      String
  minSelect Int          @default(1)
  maxSelect Int          @default(1)
  position  Int          @default(0)
  choices   MenuChoice[]

  @@index([menuId])
}

// Article proposé à une étape, avec un éventuel supplément
model MenuChoice {
  id         String   @id @default(cuid())
  stepId     String
  step       MenuStep @relation(fields: [stepId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId  String?
  supplement Decimal  @default(0) @db.Decimal(10, 2)
  position   Int      @default(0)

  @@index([stepId])
  @@index([productId])
}

model Variant {
  id        String        @id @default(cuid())
  productId String
  product   Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String // ex. "150g", "Coffret 6 pièces", "M / Noir"
  price     Decimal       @db.Decimal(10, 2)
  barcode   String?
  sku       String?
  // Combinaison d'options, ex. {"Taille": "M", "Couleur": "Noir"}
  options   Json          @default("{}")
  position  Int           @default(0)
  isActive  Boolean       @default(true)
  stock     VariantStock?
  lots      StockLot[]

  @@index([productId])
  @@index([barcode])
}

// ============================================================
// SPRINT 2 — Commandes & Encaissement
// ============================================================

model Order {
  id                  String         @id @default(cuid())
  // Vente, ou remboursement (ticket négatif signé : rien n'est jamais effacé)
  kind                OrderKind      @default(SALE)
  refundOfId          String?
  refundOf            Order?         @relation("Refunds", fields: [refundOfId], references: [id])
  refunds             Order[]        @relation("Refunds")
  refundReason        String?
  siteId              String
  site                Site           @relation(fields: [siteId], references: [id])
  channel             Channel        @default(IN_STORE)
  status              OrderStatus    @default(COMPLETED)
  items               OrderItem[]
  subtotal            Decimal        @db.Decimal(10, 2)
  taxAmount           Decimal        @db.Decimal(10, 2)
  total               Decimal        @db.Decimal(10, 2) // calculé serveur
  discount            Decimal        @default(0) @db.Decimal(10, 2)
  paymentMode         PaymentMode    @default(CARD)
  customerEmail       String?
  customerName        String? // click & collect — nom du client
  note                String?
  // Click & collect — Sprint 3
  pickupCode          String?        @unique
  scheduledAt         DateTime?
  // B2B — Sprint 7
  b2bClientId         String?
  b2bClient           B2BClient?     @relation(fields: [b2bClientId], references: [id])
  // Client fidélité rattaché à la vente, points utilisés et gagnés
  customerId          String?
  customer            Customer?      @relation(fields: [customerId], references: [id])
  loyaltyPointsUsed   Int?
  loyaltyPointsEarned Int?
  paymentTerms        Int? // jours de paiement B2B (30, 60, 90)
  invoiceNumber       String?        @unique
  invoicedAt          DateTime?
  // Facture envoyée par e-mail (service comptable du client)
  invoiceSentAt       DateTime?
  invoiceSentTo       String?
  // Ticket dématérialisé envoyé par e-mail à customerEmail
  receiptSentAt       DateTime?
  receiptChainId      String?        @unique
  receiptChain        ReceiptChain?  @relation(fields: [receiptChainId], references: [id])
  // Identifiant généré par la caisse : une vente renvoyée deux fois
  // (coupure réseau pendant l'envoi) n'est enregistrée qu'une fois
  clientId            String?        @unique
  // Heure réelle de la vente (diffère de createdAt pour une vente hors
  // ligne synchronisée après la clôture du jour)
  soldAt              DateTime?
  // Paiements détaillés (paiement fractionné, moyens configurables)
  payments            OrderPayment[]
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  @@index([siteId, createdAt])
  @@index([siteId, status])
  @@index([pickupCode])
}

model OrderItem {
  id             String   @id @default(cuid())
  // Ligne remboursée : ligne de la vente d'origine
  refundOfItemId String?
  orderId        String
  order          Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId      String
  product        Product  @relation(fields: [productId], references: [id])
  variantId      String?
  // Snapshot immuable au moment de la vente
  name           String
  variantName    String?
  lotId          String?
  serialNumber   String?
  price          Decimal  @db.Decimal(10, 2)
  taxRate        Decimal  @db.Decimal(5, 2)
  quantity       Int
  discount       Decimal  @default(0) @db.Decimal(10, 2)
  // Options choisies : [{ id, name, price }], prix compris dans price
  modifiers      Json?
  // Composant d'une formule : la formule vendue et le numéro de sa ligne
  menuProductId  String?
  menuName       String?
  menuGroup      Int?
  // Article pesé : poids et prix au kilo appliqué
  weight         Decimal? @db.Decimal(10, 3)
  pricePerKg     Decimal? @db.Decimal(10, 2)
  // Étiquette de balance scannée
  scaleLabel     String?
}

// ============================================================
// ENUMS
// ============================================================

// ============================================================
// SPRINT 7 — B2B, API publique, Webhooks
// ============================================================

// Client professionnel (restaurant, hôtel, épicerie fine...)
model B2BClient {
  id             String   @id @default(cuid())
  organizationId String
  name           String // Raison sociale
  siret          String?
  vatNumber      String? // Numéro TVA intracommunautaire
  email          String?
  phone          String?
  address        String?
  city           String?
  zipCode        String?
  country        String   @default("FR")
  discount       Decimal? @db.Decimal(5, 2) // Remise habituelle en %
  paymentTerms   Int      @default(30) // Délai de paiement en jours
  notes          String?
  orders         Order[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([organizationId])
}

// Jeton d'accès API (Personal Access Token)
model ApiToken {
  id             String    @id @default(cuid())
  userId         String
  organizationId String
  name           String
  tokenHash      String    @unique // SHA-256 du token en clair
  prefix         String // 8 premiers chars pour identification
  scopes         String[] // ["orders:read", "products:read", ...]
  lastUsedAt     DateTime?
  expiresAt      DateTime?
  isRevoked      Boolean   @default(false)
  createdAt      DateTime  @default(now())

  @@index([organizationId])
  @@index([tokenHash])
}

// Endpoint webhook
model Webhook {
  id              String    @id @default(cuid())
  organizationId  String
  url             String
  events          String[] // ["order.created", "order.completed", ...]
  secret          String // HMAC-SHA256 signing secret
  isActive        Boolean   @default(true)
  failureCount    Int       @default(0)
  lastTriggeredAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([organizationId])
}

enum Role {
  OWNER
  MANAGER
  SELLER
  PRODUCTION // opérateur de labo, cuisine centrale ou dépôt
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
}

enum Plan {
  STARTER
  PRO
  SCALE
  ENTERPRISE
}

// ============================================================
// SPRINT 4 — Stock, Allergènes, NF525 clôture journalière
// ============================================================

model StockItem {
  id        String   @id @default(cuid())
  productId String   @unique
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  siteId    String
  quantity  Decimal  @db.Decimal(10, 3)
  unit      String   @default("unité")
  alertAt   Decimal? @db.Decimal(10, 3) // seuil d'alerte
  updatedAt DateTime @updatedAt

  @@index([siteId])
  @@index([siteId, alertAt])
}

model StockMovement {
  id        String       @id @default(cuid())
  siteId    String
  productId String
  variantId String?
  lotId     String?
  type      MovementType
  quantity  Decimal      @db.Decimal(10, 3)
  reason    String?
  orderId   String? // renseigné pour les ventes
  userId    String?
  createdAt DateTime     @default(now())

  @@index([siteId, createdAt])
  @@index([productId])
}

// 14 allergènes INCO — seedés en base, non modifiables par les users
model Allergen {
  id       String            @id @default(cuid())
  name     String            @unique
  code     String            @unique // "GLUTEN", "LAIT", etc.
  isInco   Boolean           @default(true)
  products ProductAllergen[]
}

model ProductAllergen {
  productId  String
  allergenId String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  allergen   Allergen @relation(fields: [allergenId], references: [id])
  traces     Boolean  @default(false) // présence sous forme de traces

  @@id([productId, allergenId])
  @@index([productId])
}

// NF525 — Clôture journalière (ticket Z)
model DayClosure {
  id          String   @id @default(cuid())
  siteId      String
  date        DateTime // jour de clôture (minuit UTC)
  totalOrders Int
  totalAmount Decimal  @db.Decimal(10, 2)
  lastCounter Int // dernier counter NF525 de la journée
  hash        String // SHA-256 de la clôture
  closedAt    DateTime @default(now())
  closedBy    String?

  @@unique([siteId, date])
  @@index([siteId])
}

enum MovementType {
  SALE
  RESTOCK
  ADJUSTMENT
  TRANSFER
  LOSS
}

enum Channel {
  IN_STORE
  CLICK_COLLECT
  B2B
}

enum OrderStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
  CANCELLED
  REFUNDED
}

enum PaymentMode {
  CARD
  CASH
  MIXED
  INVOICE
  TICKET_RESTO
}

// ============================================================
// CŒUR MULTI-SECTEURS — secteurs, packs, configuration
// ============================================================

enum Sector {
  GENERAL
  FOOD // chocolaterie, pâtisserie, épicerie fine, traiteur
  FASHION // prêt-à-porter, maroquinerie, chaussures
  BEAUTY // parfumerie, cosmétique
  JEWELRY // joaillerie, horlogerie
  WINE // cave, spiritueux
  HOME // décoration, art de vivre
  SERVICES // prestations, ateliers
}

// Fonctions métier activables par organisation
enum Pack {
  FOOD // allergènes, DLUO/DLC, titres-restaurant
  FASHION // grille tailles × couleurs, collections, saisons
  BEAUTY // lots, dates d'expiration, testeurs
  JEWELRY // numéros de série, certificats, garanties
  WINE // millésimes, appellations
  SERVICES // prestations, durées
}

enum TrackingMode {
  NONE
  LOT // numéro de lot
  LOT_EXPIRY // numéro de lot + date limite
  SERIAL // un numéro de série par pièce
}

enum AttributeType {
  TEXT
  NUMBER
  BOOLEAN
  SELECT
  DATE
}

enum PaymentKind {
  CARD
  CASH
  VOUCHER // titres-restaurant, chèques cadeaux, avoirs
  TRANSFER
  OTHER
}

// Taux de TVA proposés à la saisie produit
model TaxRate {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  label          String // ex. "Taux normal"
  rate           Decimal      @db.Decimal(5, 2)
  isDefault      Boolean      @default(false)

  @@unique([organizationId, rate])
  @@index([organizationId])
}

// Moyens de paiement proposés en caisse
model PaymentMethod {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code              String // ex. "CARD", "CASH", "TICKET_RESTO", "GIFT_CARD"
  label             String
  kind              PaymentKind
  isActive          Boolean      @default(true)
  position          Int          @default(0)
  // Règles françaises : titre-restaurant (articles éligibles, plafond par
  // transaction, pas de rendu), chèque (numéro), espèces (rendu de monnaie)
  mealVoucher       Boolean      @default(false)
  giveChange        Boolean      @default(false)
  maxAmount         Decimal?     @db.Decimal(10, 2)
  requiresReference Boolean      @default(false)

  @@unique([organizationId, code])
  @@index([organizationId])
}

// Champs produit définis par l'organisation (matière, origine, millésime...)
model AttributeDefinition {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String // clé dans Product.attributes
  label          String
  type           AttributeType
  options        String[]      @default([]) // valeurs possibles pour SELECT
  pack           Pack? // null = champ créé par l'organisation
  required       Boolean       @default(false)
  position       Int           @default(0)

  @@unique([organizationId, key])
  @@index([organizationId])
}

// Axe de variation d'un produit, ex. Taille : [S, M, L]
model ProductOption {
  id        String   @id @default(cuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name      String
  values    String[]
  position  Int      @default(0)

  @@unique([productId, name])
  @@index([productId])
}

// Stock par variante (le StockItem reste le stock du produit sans variante)
model VariantStock {
  id        String   @id @default(cuid())
  variantId String   @unique
  variant   Variant  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  siteId    String
  quantity  Decimal  @db.Decimal(10, 3)
  alertAt   Decimal? @db.Decimal(10, 3)
  updatedAt DateTime @updatedAt

  @@index([siteId])
}

// Lots, dates limites et numéros de série
model StockLot {
  id           String    @id @default(cuid())
  siteId       String
  productId    String
  product      Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  variantId    String?
  variant      Variant?  @relation(fields: [variantId], references: [id], onDelete: Cascade)
  lotNumber    String?
  serialNumber String?
  expiresAt    DateTime?
  quantity     Decimal   @db.Decimal(10, 3)
  receivedAt   DateTime  @default(now())

  @@unique([productId, serialNumber])
  @@index([siteId, productId])
  @@index([expiresAt])
}

// Ligne de paiement d'une commande
model OrderPayment {
  id        String      @id @default(cuid())
  orderId   String
  order     Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)
  code      String // snapshot du PaymentMethod.code
  label     String
  kind      PaymentKind
  amount    Decimal     @db.Decimal(10, 2)
  // Référence du paiement chez le prestataire (TPE connecté)
  reference String?
  createdAt DateTime    @default(now())

  @@index([orderId])
}

// ============================================================
// CAISSES — signature locale des tickets (hors ligne inclus)
// ============================================================

model Terminal {
  id         String         @id @default(cuid())
  siteId     String
  site       Site           @relation(fields: [siteId], references: [id], onDelete: Cascade)
  name       String
  // Clé publique ECDSA P-256 (JWK) ; la clé privée ne quitte jamais l'appareil
  publicKey  String
  isActive   Boolean        @default(true)
  createdBy  String?
  createdAt  DateTime       @default(now())
  lastSeenAt DateTime?
  receipts   ReceiptChain[]

  @@index([siteId])
}

// ============================================================
// PAIEMENT INTÉGRÉ — la caisse envoie le montant au TPE
// ============================================================

enum PaymentProvider {
  SIMULATOR // TPE virtuel, pour essayer sans matériel
  STRIPE // Stripe Terminal (intégration pilotée par le serveur)
  SUMUP // SumUp Solo (Cloud API)
}

enum TerminalPaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  CANCELED
}

// Compte du commerçant chez un prestataire de paiement
model PaymentAccount {
  id             String          @id @default(cuid())
  organizationId String
  organization   Organization    @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  provider       PaymentProvider
  // Identifiants chiffrés (AES-256-GCM), jamais renvoyés au navigateur
  credentials    String
  // Mode test du prestataire (aucun argent réel)
  testMode       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@unique([organizationId, provider])
}

// TPE appairé à une boutique
model PaymentDevice {
  id         String            @id @default(cuid())
  siteId     String
  site       Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  provider   PaymentProvider
  name       String
  externalId String // identifiant du lecteur chez le prestataire
  isActive   Boolean           @default(true)
  createdAt  DateTime          @default(now())
  payments   TerminalPayment[]

  @@index([siteId])
}

// Une demande de paiement envoyée à un TPE
model TerminalPayment {
  id            String                @id @default(cuid())
  siteId        String
  // Absent : paiement par QR code, le client paie sur son téléphone
  deviceId      String?
  device        PaymentDevice?        @relation(fields: [deviceId], references: [id], onDelete: Restrict)
  // Paiement par QR : page de paiement du prestataire et fin de validité
  checkoutUrl   String?
  expiresAt     DateTime?
  provider      PaymentProvider
  amount        Int // en centimes
  currency      String                @default("EUR")
  status        TerminalPaymentStatus @default(PENDING)
  // Vente de la caisse à laquelle ce paiement est destiné (clientId du ticket)
  clientSaleId  String?
  providerRef   String?
  failureReason String?
  createdBy     String?
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt

  @@index([siteId, createdAt])
  @@index([deviceId, status])
  @@index([clientSaleId])
}

enum OrderKind {
  SALE
  REFUND
}

// Avoir : montant rendu au client sous forme de bon, utilisable en caisse
model StoreCredit {
  id             String                  @id @default(cuid())
  organizationId String
  organization   Organization            @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  code           String                  @unique // ex. AV-7K3P-9QXM, imprimé sur le ticket
  // CREDIT : avoir né d'un retour ; GIFT_CARD : carte cadeau vendue en caisse
  kind           String                  @default("CREDIT")
  // Vente de la carte cadeau
  soldOrderId    String?
  initialAmount  Decimal                 @db.Decimal(10, 2)
  balance        Decimal                 @db.Decimal(10, 2)
  issuedOrderId  String? // remboursement qui l'a créé
  customerEmail  String?
  expiresAt      DateTime?
  createdAt      DateTime                @default(now())
  redemptions    StoreCreditRedemption[]

  @@index([organizationId])
}

model StoreCreditRedemption {
  id        String      @id @default(cuid())
  creditId  String
  credit    StoreCredit @relation(fields: [creditId], references: [id], onDelete: Cascade)
  orderId   String
  amount    Decimal     @db.Decimal(10, 2)
  createdAt DateTime    @default(now())

  @@index([creditId])
}

// ============================================================
// Approvisionnement interne : boutique → labo / dépôt
// ============================================================

enum SupplyStatus {
  DRAFT // préparée par la boutique, pas encore envoyée
  SENT // reçue par le labo, modifiable par la boutique jusqu'à la clôture
  IN_PRODUCTION
  SHIPPED // colis prêts, quantités préparées connues
  RECEIVED
  CANCELLED
}

// Une commande par boutique, par fournisseur et par jour de livraison
model SupplyOrder {
  id             String            @id @default(cuid())
  organizationId String
  number         Int // numéro lisible, par organisation
  fromSiteId     String // boutique qui commande
  fromSite       Site              @relation("SupplyFrom", fields: [fromSiteId], references: [id])
  toSiteId       String // labo ou dépôt
  toSite         Site              @relation("SupplyTo", fields: [toSiteId], references: [id])
  deliveryDate   DateTime          @db.Date
  status         SupplyStatus      @default(DRAFT)
  note           String?
  receiptNote    String?
  sentAt         DateTime?
  productionAt   DateTime?
  shippedAt      DateTime?
  receivedAt     DateTime?
  createdById    String?
  lines          SupplyOrderLine[]
  createdAt      DateTime          @default(now())
  updatedAt      DateTime          @updatedAt

  @@unique([fromSiteId, toSiteId, deliveryDate])
  @@unique([organizationId, number])
  @@index([toSiteId, deliveryDate])
}

model SupplyOrderLine {
  id          String      @id @default(cuid())
  orderId     String
  order       SupplyOrder @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId   String // produit du labo
  variantId   String?
  name        String
  variantName String?
  unit        String?
  unitPrice   Decimal?    @db.Decimal(10, 2) // prix de cession au moment de la commande
  suggested   Decimal?    @db.Decimal(10, 3)
  ordered     Decimal     @db.Decimal(10, 3)
  prepared    Decimal?    @db.Decimal(10, 3)
  received    Decimal?    @db.Decimal(10, 3)
  issue       String? // « 2 abîmées pendant le transport »

  @@unique([orderId, productId, variantId])
}

// Fond de caisse : une session par tiroir (caisse), de l'ouverture à la fermeture
enum CashSessionStatus {
  OPEN
  CLOSED
}

model CashSession {
  id               String            @id @default(cuid())
  siteId           String
  site             Site              @relation(fields: [siteId], references: [id], onDelete: Cascade)
  terminalId       String
  status           CashSessionStatus @default(OPEN)
  openedAt         DateTime          @default(now())
  openedById       String
  // Fond annoncé par la fermeture précédente, et fond confirmé à l'ouverture
  expectedOpening  Decimal?          @db.Decimal(10, 2)
  openingFloat     Decimal           @db.Decimal(10, 2)
  openingNote      String?
  closedAt         DateTime?
  closedById       String?
  // Comptage : nombre de pièces et billets par valeur en centimes
  denominations    Json?
  counted          Decimal?          @db.Decimal(10, 2)
  expectedCash     Decimal?          @db.Decimal(10, 2)
  difference       Decimal?          @db.Decimal(10, 2)
  differenceReason String?
  keptFloat        Decimal?          @db.Decimal(10, 2)
  deposit          Decimal?          @db.Decimal(10, 2)
  // Clôturée après sa journée (oubli de la veille, rattrapé le lendemain)
  closedLate       Boolean           @default(false)

  @@index([siteId, openedAt])
  @@index([terminalId, status])
}

// Message du labo à toutes les boutiques : « Pénurie de fraises, tartes réduites de 50 % aujourd'hui »
model SupplyAlert {
  id             String   @id @default(cuid())
  organizationId String
  siteId         String // labo ou dépôt émetteur
  siteName       String
  day            DateTime @db.Date // jour de livraison concerné
  productName    String?
  reductionPct   Int?
  message        String
  createdById    String?
  createdAt      DateTime @default(now())

  @@index([organizationId, day])
}

// Journal d'audit : qui a fait quoi sur les actions sensibles. Ajout seul,
// jamais modifié ni supprimé par l'application.
model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String // ex. auth.login_failed, refund.created, cash.closed, user.role_changed
  target         String?
  detail         String?
  ip             String?
  terminalId     String?
  createdAt      DateTime @default(now())

  @@index([organizationId, createdAt])
  @@index([action, createdAt])
}

// ============================================================
// CONFORMITÉ FISCALE (art. 286 I 3° bis CGI, BOI-TVA-DECLA-30-10-30)
// Tables en ajout seul : l'application n'y fait jamais de mise à jour ni
// de suppression. Chaque table est chaînée par empreinte.
// ============================================================

enum ClosurePeriod {
  DAY
  MONTH
  YEAR
}

// Clôtures cumulatives : le Z du jour couvre une plage de tickets sans trou,
// le Z du mois cumule les Z du jour, le Z de l'année cumule les Z du mois
model FiscalClosure {
  id                String        @id @default(cuid())
  siteId            String
  site              Site          @relation(fields: [siteId], references: [id], onDelete: Restrict)
  period            ClosurePeriod
  label             String // 2026-10-14, 2026-10 ou 2026
  seq               Int // numéro de clôture du site pour cette période
  firstCounter      Int?
  lastCounter       Int?
  ticketCount       Int
  salesCount        Int
  refundCount       Int
  salesTotal        Decimal       @db.Decimal(14, 2)
  refundsTotal      Decimal       @db.Decimal(14, 2)
  periodTotal       Decimal       @db.Decimal(14, 2) // grand total de la période (TTC)
  totalHT           Decimal       @db.Decimal(14, 2)
  totalTax          Decimal       @db.Decimal(14, 2)
  taxBreakdown      Json // [{ rate, ht, tax, ttc }]
  paymentBreakdown  Json // [{ code, label, amount }]
  perpetualTotal    Decimal       @db.Decimal(14, 2)
  perpetualAbsTotal Decimal       @db.Decimal(14, 2)
  previousHash      String
  hash              String
  auto              Boolean       @default(false)
  closedAt          DateTime      @default(now())
  closedById        String?

  @@unique([siteId, period, label])
  @@unique([siteId, period, seq])
  @@index([siteId, period, closedAt])
}

// Journal des événements techniques : clôtures, archives, duplicatas, mode
// formation, caisses, vérifications, attestations, démarrages
model FiscalEvent {
  id             String   @id @default(cuid())
  organizationId String?
  siteId         String?
  seq            Int
  code           String // ex. CLOSURE_DAY, ARCHIVE_CREATED, DUPLICATE_PRINTED
  label          String
  detail         Json?
  userId         String?
  terminalId     String?
  previousHash   String
  hash           String
  createdAt      DateTime @default(now())

  @@unique([organizationId, seq])
  @@index([siteId, createdAt])
  @@index([organizationId, createdAt])
}

// Réimpressions : chaque duplicata porte son numéro et reste tracé
model ReceiptDuplicate {
  id         String   @id @default(cuid())
  orderId    String
  siteId     String
  number     Int
  userId     String?
  terminalId String?
  createdAt  DateTime @default(now())

  @@unique([orderId, number])
  @@index([siteId, createdAt])
}

// Mode formation : ventes fictives, numérotées à part, opérateur identifié,
// hors chaîne fiscale, hors stock et hors caisse
model TrainingTicket {
  id         String   @id @default(cuid())
  siteId     String
  number     Int
  userId     String
  userName   String
  terminalId String?
  total      Decimal  @db.Decimal(10, 2)
  content    Json
  createdAt  DateTime @default(now())

  @@unique([siteId, number])
  @@index([siteId, createdAt])
}

// Archives fiscales figées, en format ouvert (JSON), signées par l'éditeur
model FiscalArchive {
  id          String        @id @default(cuid())
  siteId      String
  period      ClosurePeriod
  label       String
  fromCounter Int?
  toCounter   Int?
  sha256      String
  signature   String // ECDSA P-256 (DER) en base64, clé publique de l'éditeur
  keyId       String
  size        Int
  content     Bytes // JSON compressé (gzip)
  createdById String?
  createdAt   DateTime      @default(now())

  @@unique([siteId, period, label])
  @@index([siteId, createdAt])
}

// Clé de signature de l'éditeur (archives, attestations) : la clé privée
// est chiffrée au repos ; FISCAL_SIGNING_KEY la remplace en production
model SigningKey {
  id         String   @id @default(cuid())
  keyId      String   @unique
  publicKey  String // PEM SPKI
  privateKey String // PEM PKCS8 chiffré
  createdAt  DateTime @default(now())
}

// Routine de fermeture d'une boutique, réglée par le gérant : heure de
// fermeture, tâches à faire avant (commande fournisseur, clôture de caisse,
// tâches libres), rappels progressifs sur la caisse et alerte au gérant
model SiteRoutine {
  id                String   @id @default(cuid())
  siteId            String   @unique
  site              Site     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  enabled           Boolean  @default(true)
  // Heures locales « HH:MM » ; avant 05:00, c'est la nuit suivante
  closingTime       String   @default("19:30")
  // Commande au fournisseur (labo, dépôt, centrale) avant cette heure ; null : pas de rappel
  supplyDeadline    String?
  // Comptage et clôture de la caisse avant cette heure ; null : heure de fermeture
  cashDeadline      String?
  // Jours d'ouverture (1 lundi ... 7 dimanche)
  days              Int[]    @default([1, 2, 3, 4, 5, 6])
  // Bandeau discret N minutes avant l'échéance
  reminderMinutes   Int      @default(30)
  // Alerte au gérant et verrouillage N minutes après la fermeture si la caisse est restée ouverte
  alertAfterMinutes Int      @default(60)
  autoLock          Boolean  @default(true)
  // Destinataires de l'alerte ; vide : propriétaires et gérants
  notifyEmails      String[] @default([])
  // Tâches libres : [{ key, label, deadline? }]
  tasks             Json     @default("[]")
  updatedAt         DateTime @updatedAt
}

// Tâche de la routine cochée sur la caisse, pour une journée
model RoutineCheck {
  id       String   @id @default(cuid())
  siteId   String
  day      String // journée commerciale « AAAA-MM-JJ »
  key      String
  doneAt   DateTime @default(now())
  userId   String?
  userName String?

  @@unique([siteId, day, key])
}

// Alerte envoyée au gérant (une par journée et par motif)
model RoutineAlert {
  id         String   @id @default(cuid())
  siteId     String
  day        String
  kind       String // UNCLOSED
  sentAt     DateTime @default(now())
  recipients String[]

  @@unique([siteId, day, kind])
}

// Écran client sur une tablette séparée, appairé à une caisse par un code
model CustomerDisplay {
  id            String    @id @default(cuid())
  // Empreinte du jeton gardé par la tablette (le jeton n'est jamais stocké)
  tokenHash     String    @unique
  // Code à 6 chiffres affiché par la tablette tant qu'elle n'est pas appairée
  pairCode      String?   @unique
  pairExpiresAt DateTime?
  siteId        String?
  site          Site?     @relation(fields: [siteId], references: [id], onDelete: Cascade)
  terminalId    String?
  pairedAt      DateTime?
  lastSeenAt    DateTime?
  createdAt     DateTime  @default(now())

  @@index([siteId])
}

// Client particulier, pour la fidélité : retrouvé par téléphone ou e-mail
model Customer {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  firstName      String?
  lastName       String?
  // Téléphone normalisé (+33...) et e-mail en minuscules
  phone          String?
  email          String?
  points         Int            @default(0)
  totalSpent     Decimal        @default(0) @db.Decimal(12, 2)
  visits         Int            @default(0)
  lastVisitAt    DateTime?
  // Accord pour recevoir des offres (distinct de l'inscription à la fidélité)
  marketingOptIn Boolean        @default(false)
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  orders         Order[]
  entries        LoyaltyEntry[]

  @@unique([organizationId, phone])
  @@unique([organizationId, email])
  @@index([organizationId])
}

// Mouvement de points : gagnés, utilisés, repris sur un remboursement, ajustés
model LoyaltyEntry {
  id         String   @id @default(cuid())
  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  orderId    String?
  points     Int
  reason     String // EARN, REDEEM, REFUND, ADJUST
  note       String?
  createdAt  DateTime @default(now())

  @@index([customerId, createdAt])
}

// ============================================================
// AIDE ET SUPPORT : conversation commerçant et équipe FLŌW dans l'application
// Délai annoncé : configuration (SUPPORT_SLA_MINUTES, SUPPORT_HOURS).
// Identifiants simples, sans relation vers Organization ou User : le fil
// reste lisible par l'équipe si un compte est supprimé.
// ============================================================

enum SupportStatus {
  OPEN // à traiter par l'équipe
  WAITING_CUSTOMER // l'équipe a répondu, on attend le commerçant
  RESOLVED
}

enum SupportPriority {
  NORMAL
  URGENT // la caisse ne peut plus encaisser
}

enum SupportAuthor {
  USER
  AGENT
  SYSTEM
}

model SupportThread {
  id              String           @id @default(cuid())
  organizationId  String
  siteId          String?
  userId          String
  subject         String
  status          SupportStatus    @default(OPEN)
  priority        SupportPriority  @default(NORMAL)
  // Réponse attendue avant : délai annoncé, heures d'ouverture comprises
  dueAt           DateTime
  firstResponseAt DateTime?
  // Première réponse arrivée avant dueAt
  slaMet          Boolean?
  lastMessageAt   DateTime         @default(now())
  // Version, page, caisse, réseau, navigateur, dernières erreurs
  context         Json?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  messages        SupportMessage[]

  @@index([organizationId, lastMessageAt])
  @@index([status, dueAt])
}

model SupportMessage {
  id         String        @id @default(cuid())
  threadId   String
  thread     SupportThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  author     SupportAuthor
  authorId   String?
  authorName String
  body       String
  createdAt  DateTime      @default(now())
  // Lu par l'autre partie
  readAt     DateTime?

  @@index([threadId, createdAt])
}
