NEXT_PUBLIC_API_URL="http://localhost:3001"
NEXT_PUBLIC_WS_URL="ws://localhost:3001"
NEXT_PUBLIC_SENTRY_DSN=""
SENTRY_DSN=""
# FLŌW-Bridge, agent local de la boutique (imprimante, tiroir, TPE).
# Côté pont, autoriser l'adresse du site : FLOW_BRIDGE_ORIGINS="https://caisse.exemple.fr"
NEXT_PUBLIC_BRIDGE_URL="ws://127.0.0.1:51717"

# Pages légales publiques (/legal/...). Identité de l'éditeur, alignée sur les
# EDITOR_* de l'API (attestation fiscale). Valeur vide : « [à compléter] » affiché.
NEXT_PUBLIC_EDITOR_COMPANY=""            # raison sociale, ou nom et prénom pour un entrepreneur individuel
NEXT_PUBLIC_EDITOR_STATUS=""             # forme juridique : SAS, SARL... ou « entrepreneur individuel »
NEXT_PUBLIC_EDITOR_CAPITAL=""            # capital social (société seulement), ex. « 1 000 € »
NEXT_PUBLIC_EDITOR_SIREN=""
NEXT_PUBLIC_EDITOR_REGISTRY=""           # ex. « RCS Lyon » ou « RNE »
NEXT_PUBLIC_EDITOR_VAT_NUMBER=""         # numéro de TVA intracommunautaire, s'il existe
NEXT_PUBLIC_EDITOR_VAT_FRANCHISE=""      # « oui » seulement en franchise en base : « TVA non applicable, art. 293 B du CGI »
NEXT_PUBLIC_EDITOR_ADDRESS=""            # siège social, ou adresse de domiciliation de l'EI
NEXT_PUBLIC_EDITOR_EMAIL=""
NEXT_PUBLIC_EDITOR_PHONE=""
NEXT_PUBLIC_EDITOR_REPRESENTATIVE=""     # représentant légal
NEXT_PUBLIC_EDITOR_DIRECTOR=""           # directeur de la publication
NEXT_PUBLIC_EDITOR_PRIVACY_EMAIL=""      # contact données personnelles (à défaut : NEXT_PUBLIC_EDITOR_EMAIL)
NEXT_PUBLIC_EDITOR_DPO=""                # délégué à la protection des données, s'il est désigné
NEXT_PUBLIC_LEGAL_COURT=""               # juridiction compétente des CGV, à fixer avec le juriste
NEXT_PUBLIC_HOST_NAME=""                 # hébergeur : nom ou dénomination
NEXT_PUBLIC_HOST_ADDRESS=""
NEXT_PUBLIC_HOST_PHONE=""
