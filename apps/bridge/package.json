{
  "name": "@erp/bridge",
  "version": "0.1.0",
  "private": true,
  "description": "FLŌW-Bridge : pont local entre la caisse FLŌW (navigateur) et le matériel du magasin",
  "type": "module",
  "main": "./dist/index.js",
  "bin": {
    "flow-bridge": "./dist/index.js"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch",
    "start": "node dist/index.js",
    "pair": "node dist/index.js pair",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src",
    "package": "node scripts/package.mjs"
  },
  "dependencies": {
    "ws": "8.21.0"
  },
  "devDependencies": {
    "@erp/config": "workspace:*",
    "@types/node": "22.19.19",
    "@types/ws": "8.18.1",
    "esbuild": "0.27.7",
    "eslint": "9.39.4",
    "fflate": "0.8.3",
    "typescript": "5.9.3",
    "vitest": "3.2.4"
  }
}
