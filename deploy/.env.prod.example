# FLŌW, variables du serveur (docker-compose.prod.yml).
# Copier en deploy/.env.prod, compléter, puis : chmod 600 deploy/.env.prod
# Contrôle : ./deploy/flow verifier-config
# Les secrets de l'application (JWT, clé de signature fiscale, Stripe, Resend)
# sont dans apps/api/.env.production, produit par ./deploy/flow configurer.

# ── Adresses publiques ─────────────────────────────────────────
# Deux sous-domaines dont l'enregistrement DNS (A, et AAAA si IPv6) pointe vers ce serveur
APP_DOMAIN=caisse.exemple.fr
API_DOMAIN=api.exemple.fr
# Adresse e-mail transmise à Let's Encrypt (avis d'expiration des certificats)
ACME_EMAIL=

# Fuseau horaire des conteneurs et de l'heure de sauvegarde
TZ=Europe/Paris

# ── Base de données (interne au serveur, jamais exposée) ──────
POSTGRES_USER=flow
POSTGRES_DB=flow
# Laisser vide : ./deploy/flow configurer en génère un (48 caractères hexadécimaux)
POSTGRES_PASSWORD=

# ── Sauvegardes (docs/sauvegardes.md) ──────────────────────────
# Clé PUBLIQUE age (age1…). La clé privée reste hors du serveur (coffre de mots de passe, papier).
# Plusieurs clés possibles, séparées par des virgules.
BACKUP_AGE_RECIPIENT=

# Stockage objet compatible S3, chez un autre prestataire ou au moins dans une autre région.
# Exemples d'adresses (à vérifier dans la console du fournisseur) :
#   OVHcloud Object Storage : https://s3.gra.io.cloud.ovh.net, région gra
#   Scaleway Object Storage : https://s3.fr-par.scw.cloud, région fr-par
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=
BACKUP_S3_BUCKET=
BACKUP_S3_ACCESS_KEY_ID=
BACKUP_S3_SECRET_ACCESS_KEY=
# Dossier dans le seau
BACKUP_PREFIX=flow

# Horaires (format cron, heure de TZ) : sauvegarde chaque nuit, contrôle toutes les 6 heures
BACKUP_CRON="15 3 * * *"
BACKUP_CHECK_CRON="0 */6 * * *"

# Rétention : quotidiennes, mensuelles (1re du mois), annuelles (1re de l'année)
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
BACKUP_KEEP_YEARLY=7
# Alerte si la dernière sauvegarde a plus de N heures
BACKUP_MAX_AGE_HOURS=26

# ── Alertes (au moins une des deux, conseillé : les deux) ─────
# Adresse de ping fournie par un service de surveillance (healthchecks.io ou équivalent) :
# il prévient si les pings cessent, même quand le serveur entier est arrêté.
BACKUP_PING_URL=
# E-mail d'alerte envoyé par Resend (même compte que l'application)
BACKUP_ALERT_EMAIL=
BACKUP_ALERT_FROM=
BACKUP_RESEND_API_KEY=
